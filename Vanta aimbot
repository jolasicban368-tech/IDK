-- scale UI larger on mobile so it's tappable
local SCALE = IS_MOBILE and 1.35 or 1.0
local function px(n) return math.floor(n * SCALE) end

local function make(cls, props, parent)
    local o = Instance.new(cls)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function corner(r, p)
    make("UICorner", { CornerRadius = UDim.new(0, r) }, p)
end

local function tw(obj, props, t)
    TweenSvc:Create(obj, TweenInfo.new(t or 0.14, Enum.EasingStyle.Quad), props):Play()
end

