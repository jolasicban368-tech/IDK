-- ── FOV visual ────────────────────────────────────────────────────────────────
-- Drawing API path (Xeno / Delta / Solara all support this)
local fov_circle, fov_frame

if HAS_DRAWING then
    fov_circle           = Drawing.new("Circle")
    fov_circle.Visible   = cfg.show_fov
    fov_circle.Radius    = cfg.fov
    fov_circle.Color     = Color3.fromRGB(255, 60, 60)
    fov_circle.Thickness = 1.5
    fov_circle.Filled    = false
    fov_circle.NumSides  = 64
else
    -- ScreenGui fallback — square approximation via UICorner
    local sg_fov = Instance.new("ScreenGui")
    sg_fov.ResetOnSpawn      = false
    sg_fov.IgnoreGuiInset    = true
    sg_fov.ZIndexBehavior    = Enum.ZIndexBehavior.Sibling
    sg_fov.Parent            = get_safe_parent()

    local d = cfg.fov * 2
    fov_frame = Instance.new("Frame")
    fov_frame.Size                  = UDim2.new(0, d, 0, d)
    fov_frame.AnchorPoint           = Vector2.new(0.5, 0.5)
    fov_frame.Position              = UDim2.new(0.5, 0, 0.5, 0)
    fov_frame.BackgroundTransparency = 1
    fov_frame.BorderSizePixel       = 0
    fov_frame.Parent                = sg_fov

    local stroke = Instance.new("UIStroke")
    stroke.Color     = Color3.fromRGB(255, 60, 60)
    stroke.Thickness = 1.5
    stroke.Parent    = fov_frame

    Instance.new("UICorner", fov_frame).CornerRadius = UDim.new(1, 0)
end

local function update_fov_visual(visible, radius)
    if HAS_DRAWING and fov_circle then
        fov_circle.Visible = visible
        fov_circle.Radius  = radius
        local vp = cam.ViewportSize
        fov_circle.Position = Vector2.new(vp.X / 2, vp.Y / 2)
    elseif fov_frame then
        fov_frame.Visible = visible
        local d = radius * 2
        fov_frame.Size = UDim2.new(0, d, 0, d)
    end
end

-- ── Aimbot helpers ────────────────────────────────────────────────────────────
local function get_center()
    return Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
end

local function is_alive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function is_enemy(player)
    if not cfg.team_check then return true end
    if not lp.Team or not player.Team then return true end
    return player.Team ~= lp.Team
end

local function is_visible(part)
    if not cfg.visible_only then return true end
    local origin = cam.CFrame.Position
    local ray    = Ray.new(origin, part.Position - origin)
    local hit    = workspace:FindPartOnRayWithIgnoreList(
        ray, { lp.Character, cam })
    return hit and hit:IsDescendantOf(part.Parent)
end

local function get_target()
    local best, best_dist = nil, cfg.fov
    local center          = get_center()

    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        if not is_enemy(p) then continue end

        local char = p.Character
        if not is_alive(char) then continue end

        local part = char:FindFirstChild(cfg.target_part)
        if not part then continue end

        local sp, on_screen = cam:WorldToViewportPoint(part.Position)
        if not on_screen then continue end

        local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if dist < best_dist and is_visible(part) then
            best_dist = dist
            best      = part
        end
    end

    return best
end

local function aim_at(part)
    local cf = CFrame.lookAt(cam.CFrame.Position, part.Position)
    cam.CFrame = cam.CFrame:Lerp(cf, cfg.smoothing)
end

-- ── Aim trigger logic ─────────────────────────────────────────────────────────
-- PC : hold RMB (when hold_to_aim = true)
-- Mobile : auto when enabled (no hold needed)
local function aim_trigger_active()
    if not cfg.enabled then return false end
    if IS_MOBILE then return true end
    if cfg.hold_to_aim then
        return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    end
    return true
end

RunService.RenderStepped:Connect(function()
    update_fov_visual(cfg.show_fov, cfg.fov)
    if not aim_trigger_active() then return end
    local t = get_target()
    if t then aim_at(t) end
end)

