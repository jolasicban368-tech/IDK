-- ── Drag (pointer + touch) ────────────────────────────────────────────────────
do
    local dragging, offset = false, Vector2.new()

    local function begin_drag(pos)
        dragging = true
        offset   = Vector2.new(
            pos.X - win.AbsolutePosition.X,
            pos.Y - win.AbsolutePosition.Y)
    end
    local function move_drag(pos)
        if not dragging then return end
        win.Position = UDim2.new(0,
