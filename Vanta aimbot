local function toggle(label, default, cb)
    local row = make("Frame", {
        Size             = UDim2.new(1, 0, 0, px(34)),
        BackgroundColor3 = C.panel,
        BorderSizePixel  = 0,
        LayoutOrder      = next_order(),
    }, content)
    corner(6, row)

    make("TextLabel", {
        Size               = UDim2.new(1, -px(54), 1, 0),
        Position           = UDim2.new(0, px(10), 0, 0),
        BackgroundTransparency = 1,
        Text               = label,
        TextColor3         = C.text,
        TextXAlignment     = Enum.TextXAlignment.Left,
        Font               = Enum.Font.Gotham,
        TextSize           = px(11),
    }, row)

    local pill = make("Frame", {
        Size             = UDim2.new(0, px(38), 0, px(20)),
        Position         = UDim2.new(1, -px(48), 0.5, -px(10)),
        BackgroundColor3 = default and C.on or C.off,
        BorderSizePixel  = 0,
    }, row)
    corner(px(10), pill)

    local knob = make("Frame", {
        Size             = UDim2.new(0, px(14), 0, px(14)),
        Position         = default
                           and UDim2.new(1, -px(17), 0.5, -px(7))
                           or  UDim2.new(0, px(3),   0.5, -px(7)),
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel  = 0,
    }, pill)
    corner(px(7), knob)

    local state = default
    make("TextButton", {
        Size               = UDim2.new(1,0,1,0),
        BackgroundTransparency = 1,
        Text               = "",
    }, row).MouseButton1Click:Connect(function()
        state = not state
        tw(pill,  { BackgroundColor3 = state and C.on or C.off })
        tw(knob,  { Position = state
                    and UDim2.new(1, -px(17), 0.5, -px(7))
                    or  UDim2.new(0,  px(3),  0.5, -px(7)) })
        cb(state)
    end)

    return state, function(v) -- expose setter for external sync
        state = v
        pill.BackgroundColor3 = v and C.on or C.off
        knob.Position = v
            and UDim2.new(1, -px(17), 0.5, -px(7))
            or  UDim2.new(0,  px(3),  0.5, -px(7))
    end
end

local function slider(label, min_v, max_v, default, fmt, cb)
    local row = make("Frame", {
        Size             = UDim2.new(1, 0, 0, px(50)),
        BackgroundColor3 = C.panel,
        BorderSizePixel  = 0,
        LayoutOrder      = next_order(),
    }, content)
    corner(6, row)

    local val_lbl = make("TextLabel", {
        Size               = UDim2.new(1, -px(10), 0, px(20)),
        Position           = UDim2.new(0, px(10), 0, px(4)),
        BackgroundTransparency = 1,
        Text               = label .. ":  " .. string.format(fmt, default),
        TextColor3         = C.text,
        TextXAlignment     = Enum.TextXAlignment.Left,
        Font               = Enum.Font.Gotham,
        TextSize           = px(11),
    }, row)

    local track = make("Frame", {
        Size             = UDim2.new(1, -px(20), 0, px(4)),
        Position         = UDim2.new(0, px(10), 0, px(34)),
        BackgroundColor3 = C.slider,
        BorderSizePixel  = 0,
    }, row)
    corner(2, track)

    local pct  = (default - min_v) / (max_v - min_v)
    local fill = make("Frame", {
        Size             = UDim2.new(pct, 0, 1, 0),
        BackgroundColor3 = C.accent,
        BorderSizePixel  = 0,
    }, track)
    corner(2, fill)

    local thumb = make("Frame", {
        Size             = UDim2.new(0, px(12), 0, px(12)),
        Position         = UDim2.new(pct, -px(6), 0.5, -px(6)),
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel  = 0,
    }, track)
    corner(px(6), thumb)

    local function set_val(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = min_v + (max_v - min_v) * rel
        fill.Size      = UDim2.new(rel, 0, 1, 0)
        thumb.Position = UDim2.new(rel, -px(6), 0.5, -px(6))
        val_lbl.Text   = label .. ":  " .. string.format(fmt, val)
        cb(val)
    end

    local drag = false
    make("TextButton", {
        Size               = UDim2.new(1,0,1,0),
        BackgroundTransparency = 1,
        Text               = "",
    }, track).MouseButton1Down:Connect(function() drag = true end)

    UIS.InputChanged:Connect(function(inp)
        if drag and inp.UserInputType == Enum.UserInputType.MouseMovement then
            set_val(inp.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)

    -- mobile touch
    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch then
            drag = true
            set_val(inp.Position.X)
        end
    end)
    track.InputChanged:Connect(function(inp)
        if drag and inp.UserInputType == Enum.UserInputType.Touch then
            set_val(inp.Position.X)
        end
    end)
    track.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
end

local function dropdown(label, options, default, cb)
    local row = make("Frame", {
        Size             = UDim2.new(1, 0, 0, px(34)),
        BackgroundColor3 = C.panel,
        BorderSizePixel  = 0,
        LayoutOrder      = next_order(),
    }, content)
    corner(6, row)

    make("TextLabel", {
        Size               = UDim2.new(0.5, 0, 1, 0),
        Position           = UDim2.new(0, px(10), 0, 0),
        BackgroundTransparency = 1,
        Text               = label,
        TextColor3         = C.text,
        TextXAlignment     = Enum.TextXAlignment.Left,
        Font               = Enum.Font.Gotham,
        TextSize           = px(11),
    }, row)

    local sel = default
    local btn = make("TextButton", {
        Size             = UDim2.new(0, px(110), 0, px(24)),
        Position         = UDim2.new(1, -px(118), 0.5, -px(12)),
        BackgroundColor3 = C.slider,
        Text             = sel,
        TextColor3       = C.text,
        Font             = Enum.Font.Gotham,
        TextSize         = px(10),
        BorderSizePixel  = 0,
    }, row)
    corner(5, btn)

    btn.MouseButton1Click:Connect(function()
        local i = table.find(options, sel) or 1
        sel      = options[(i % #options) + 1]
        btn.Text = sel
        cb(sel)
    end)
end

