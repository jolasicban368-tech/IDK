-- ── Executor compatibility ────────────────────────────────────────────────────
-- Priority: syn.protect_gui → gethui() → CoreGui
local function get_safe_parent()
    if syn and syn.protect_gui then
        -- Synapse X style (some builds of Solara inherit this)
        local sg = Instance.new("ScreenGui")
        pcall(syn.protect_gui, sg)
        sg.Parent = game:GetService("CoreGui")
        return sg
    elseif gethui then
        -- Xeno, Delta, Solara standard
        return gethui()
    else
        -- bare fallback
        return game:GetService("CoreGui")
    end
end

